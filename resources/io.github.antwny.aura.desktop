[Desktop Entry]
Version=1.5
Type=Application
Name=Aura
GenericName=Live Wallpaper Manager
Comment=Animated live wallpaper manager for COSMIC Desktop
TryExec=aura
Exec=aura
Icon=io.github.antwny.aura
Terminal=false
StartupNotify=true
Actions=Switcher;
